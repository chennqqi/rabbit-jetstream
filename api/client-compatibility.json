    {"id": "rabbitmq-amqp-python", "examples": ["Pika", "aio-pika", "Celery AMQP transport"], "status": "not_supported", "action": "Keep RabbitMQ or rewrite the application integration; this server has no AMQP listener."},
    {"id": "rabbitmq-amqp-dotnet", "examples": ["RabbitMQ.Client", "MassTransit RabbitMQ transport"], "status": "not_supported", "action": "Keep RabbitMQ or rewrite the application integration; this server has no AMQP listener."},
    {"id": "nats-core-clients", "examples": ["nats.go", "jnats", "nats.py", "NATS.Net"], "status": "partial", "action": "Use JetStream primitives only with the resource and message contract documented here; exchange resolution and priority scheduling remain application responsibilities."},
    {"id": "rabbit-jetstream-native-sdk", "examples": ["outlink/rabbit-jetstream-go"], "status": "planned", "action": "Develop and version in its independent repository; it is not part of this server build."}
