    {"id": "topic-routing", "rabbitmq": "topic exchange with * and #", "server": "queue-scoped subject mapping including zero-token #", "status": "supported", "evidence": ["internal/topology/plan.go", "tests/integration/docker-desktop.ps1"]},
    {"id": "fanout-routing", "rabbitmq": "fanout exchange", "server": "one queue-scoped publish per matching Queue", "status": "partial", "evidence": ["docs/queue-mapping.md"]},
    {"id": "publisher-confirm", "rabbitmq": "publisher confirms and mandatory return", "server": "available in migration dual-write adapter; native SDK API pending", "status": "partial", "evidence": ["tools/rjsctl/migrate_dualwrite.go", "tests/integration/shadow-capture.ps1"]},
