# The cutover fixture executes /bin/cp, which is absent from distroless.
# Reuse the exact production CLI with fixture commands in a test-only image.
FROM rabbit-jetstream/operator:shadow-test AS operator
FROM golang@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58
COPY --from=operator /usr/local/bin/rjsctl /usr/local/bin/rjsctl
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/rjsctl"]
