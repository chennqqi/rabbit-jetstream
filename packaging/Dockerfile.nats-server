FROM --platform=$BUILDPLATFORM golang:1.25.13-alpine@sha256:1e0126852075c9c60731c8ba49088448b91f63e2aed97ca9d1a9791622a05946 AS build
ARG TARGETOS
ARG TARGETARCH
ARG NATS_X_CRYPTO_VERSION=v0.53.0
WORKDIR /src/upstream/nats-server
COPY upstream/nats-server/ ./
RUN go get golang.org/x/crypto@${NATS_X_CRYPTO_VERSION} \
    && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/nats-server . \
    && mkdir -p /out/data/jetstream

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
COPY --from=build /out/nats-server /usr/local/bin/nats-server
COPY --chown=65532:65532 --from=build /out/data /data
USER 65532:65532
EXPOSE 4222 6222 8222
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/nats-server"]
