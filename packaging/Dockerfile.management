FROM --platform=$BUILDPLATFORM golang:1.25.13-alpine@sha256:1e0126852075c9c60731c8ba49088448b91f63e2aed97ca9d1a9791622a05946 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY management ./management
COPY internal ./internal
COPY admin-ui ./admin-ui
COPY api ./api
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/rjs-management ./management/cmd/rjs-management

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=build /out/rjs-management /usr/local/bin/rjs-management
EXPOSE 8223
HEALTHCHECK --interval=5s --timeout=3s --retries=12 CMD ["/usr/local/bin/rjs-management", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/rjs-management"]
