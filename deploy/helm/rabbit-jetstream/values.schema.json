{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "production": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "nats": {
      "type": "object", "additionalProperties": false,
      "required": ["replicaCount", "image", "storage", "resources", "tls"],
      "properties": {
        "replicaCount": {"type": "integer", "enum": [1, 3, 5]},
        "image": {"$ref": "#/definitions/image"},
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["size", "storageClass"],
          "properties": {"size": {"type": "string", "minLength": 1}, "storageClass": {"type": "string"}}
        },
        "resources": {"type": "object"},
        "tls": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "serverSecret", "clientSecret", "caKey", "certKey", "keyKey", "serverName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "serverSecret": {"type": "string"},
            "clientSecret": {"type": "string"},
            "caKey": {"type": "string", "minLength": 1},
            "certKey": {"type": "string", "minLength": 1},
            "keyKey": {"type": "string", "minLength": 1},
            "serverName": {"type": "string"}
          }
        }
      }
    },
    "management": {
      "type": "object", "additionalProperties": false,
      "required": ["replicaCount", "image", "service", "resources", "telemetry"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {"type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "resources": {"type": "object"},
        "telemetry": {
          "type": "object", "additionalProperties": false,
          "required": ["tracesEndpoint", "metricsEndpoint", "metricInterval", "sampleRatio", "allowInsecure"],
          "properties": {
            "tracesEndpoint": {"type": "string"},
            "metricsEndpoint": {"type": "string"},
            "metricInterval": {"type": "string", "minLength": 1},
            "sampleRatio": {"type": "number", "minimum": 0, "maximum": 1},
            "allowInsecure": {"type": "boolean"}
          }
        }
      }
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["image"],
      "properties": {"image": {"$ref": "#/definitions/image"}}
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["existingSecret", "username", "oidc"],
      "properties": {
        "existingSecret": {"type": "string"},
        "username": {"type": "string", "minLength": 1},
        "oidc": {
          "type": "object", "additionalProperties": false,
          "required": ["issuer", "audience", "roleClaim", "operatorRole", "auditorRole", "allowInsecureIssuer"],
          "properties": {
            "issuer": {"type": "string"}, "audience": {"type": "string"},
            "roleClaim": {"type": "string", "minLength": 1},
            "operatorRole": {"type": "string", "minLength": 1},
            "auditorRole": {"type": "string", "minLength": 1},
            "allowInsecureIssuer": {"type": "boolean"}
          }
        }
      }
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["interval", "leaseTTL"],
      "properties": {"interval": {"type": "string", "minLength": 1}, "leaseTTL": {"type": "string", "minLength": 1}}
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "ingress", "monitoring", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}},
            "podSelector": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "allOf": [{
            "if": {"properties": {"enabled": {"const": true}}},
            "then": {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}
          }]
        },
        "monitoring": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}},
            "podSelector": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "allOf": [{
            "if": {"properties": {"enabled": {"const": true}}},
            "then": {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}
          }]
        },
        "egress": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "dns", "additionalRules"],
          "properties": {
            "enabled": {"type": "boolean"},
            "dns": {
              "type": "object", "additionalProperties": false,
              "required": ["namespaceSelector", "podSelector"],
              "properties": {
                "namespaceSelector": {"type": "object", "additionalProperties": {"type": "string"}},
                "podSelector": {"type": "object", "additionalProperties": {"type": "string"}}
              }
            },
            "additionalRules": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["to", "ports"],
                "properties": {
                  "to": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/networkPolicyPeer"}},
                  "ports": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["port", "protocol"],
                      "properties": {
                        "port": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 65535}, {"type": "string", "minLength": 1}]},
                        "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]},
                        "endPort": {"type": "integer", "minimum": 1, "maximum": 65535}
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [{
            "if": {"properties": {"enabled": {"const": true}}},
            "then": {"properties": {"dns": {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}}}
          }]
        }
      }
    },
    "podDisruptionBudget": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "serviceMonitor": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}}},
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {"type": "string", "minLength": 1},
              "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "labelSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {"matchLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}}
    },
    "networkPolicyPeer": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "podSelector": {"$ref": "#/definitions/labelSelector"},
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "ipBlock": {
          "type": "object", "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": {"type": "string", "minLength": 1},
            "except": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
