{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "nats": {
      "type": "object", "additionalProperties": false,
      "required": ["replicaCount", "image", "storage", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "enum": [1, 3, 5]},
        "image": {"$ref": "#/definitions/image"},
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["size", "storageClass"],
          "properties": {"size": {"type": "string", "minLength": 1}, "storageClass": {"type": "string"}}
        },
        "resources": {"type": "object"}
      }
    },
    "management": {
      "type": "object", "additionalProperties": false,
      "required": ["replicaCount", "image", "service", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {"type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "resources": {"type": "object"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["existingSecret", "username", "oidc"],
      "properties": {
        "existingSecret": {"type": "string"},
        "username": {"type": "string", "minLength": 1},
        "oidc": {
          "type": "object", "additionalProperties": false,
          "required": ["issuer", "audience", "roleClaim", "operatorRole", "auditorRole", "allowInsecureIssuer"],
          "properties": {
            "issuer": {"type": "string"}, "audience": {"type": "string"},
            "roleClaim": {"type": "string", "minLength": 1},
            "operatorRole": {"type": "string", "minLength": 1},
            "auditorRole": {"type": "string", "minLength": 1},
            "allowInsecureIssuer": {"type": "boolean"}
          }
        }
      }
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["interval", "leaseTTL"],
      "properties": {"interval": {"type": "string", "minLength": 1}, "leaseTTL": {"type": "string", "minLength": 1}}
    },
    "networkPolicy": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "podDisruptionBudget": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "serviceMonitor": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}}},
    "ingress": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
